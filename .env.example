# The tag the built image is given.
APP_VERSION=dev
WEB_PORT=3000

# Where the browser reaches the API. Empty means "same origin" (a proxy or Route sends /api there).
API_BASE_URL=http://localhost:8080

# What this deployment calls itself. Leave empty to keep the app's own name, mark and colour.
# ACCENT_COLOR must be a hex colour; anything else is ignored rather than half-applied.
APP_NAME=
BRAND_MARK=
ACCENT_COLOR=
